# NOTE: everything from WORK_START down to SALARY_CURRENCY can be changed later by the admin on the
# "Settings" page. The values here are only the starting defaults.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/staff_attendance
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
# Where the Angular app is served. The QR code opens {FRONTEND_URL}/scan?t=...
FRONTEND_URL=http://localhost:4200

# Work day starts at this time (24h, server local time). Check-ins after it + grace are marked "late".
WORK_START=09:00
LATE_GRACE_MINUTES=10

# ---- Location check (optional) ----
# Leave OFFICE_LAT / OFFICE_LNG empty to switch the location check off.
# When set, staff must be within OFFICE_RADIUS_METERS of the office to check in or out.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_METERS=200

# ---- QR check (optional) ----
# true  = staff MUST scan the office QR code (shown on the admin "QR code" page) to check in/out
# false = QR scanning is available but not required
REQUIRE_QR=false
# The QR code changes every N minutes (the previous code is still accepted for one more window)
QR_WINDOW_MINUTES=5

# ---- Payroll (salary based on absence) ----
# Weekend days: 0=Sunday 1=Monday ... 6=Saturday. Default Saturday+Sunday.
# (Friday+Saturday weekend would be: 5,6)
WEEKEND_DAYS=0,6
# Public holidays (not counted as working days), comma separated YYYY-MM-DD
HOLIDAYS=
# Days of pay deducted for each absent day. 1 = one day's pay.
ABSENT_DEDUCTION_FACTOR=1
# Late arrivals: every LATE_COUNT_THRESHOLD late check-ins in a month deduct LATE_DEDUCTION_DAYS days of pay.
# Default: every 3 lates = half a day. Set LATE_COUNT_THRESHOLD=0 to switch late deductions off.
# (What counts as "late" is set by WORK_START and LATE_GRACE_MINUTES above.)
LATE_COUNT_THRESHOLD=3
LATE_DEDUCTION_DAYS=0.5
SALARY_CURRENCY=AED
# Pay period start day: 1 = calendar month. 20 = pay month runs 20th to 19th (named after the month it ends in)
PAYROLL_START_DAY=1
# Hours in one paid day: used for hourly staff (paid leave and late deductions). Not used for monthly or daily staff.
PAY_HOURS_PER_DAY=8
